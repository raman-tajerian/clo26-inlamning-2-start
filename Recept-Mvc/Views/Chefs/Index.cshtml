@model List<Chef>
@{
    ViewData["Title"] = "Kockar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Kockar</h1>
    <a class="btn btn-primary" asp-action="Create">Lägg till kock</a>
</div>

@if (Model.Count == 0)
{
    <p>Det finns inga kockar än.</p>
}
else
{
    <ul class="list-group">
        @foreach (Chef chef in Model)
        {
            <li class="list-group-item">@chef.FirstName</li>
        }
    </ul>
}
